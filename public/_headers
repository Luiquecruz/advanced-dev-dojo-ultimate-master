/assets/python.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'

/assets/csharp.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/dotnet/*
  Cache-Control: public, max-age=31536000, immutable
